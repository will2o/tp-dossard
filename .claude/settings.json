{
  "permissions": {
    "allow": [
      "mcp__plugin_dossard-equipe_dossard__list_views"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(type *.env*)",
      "Bash(grep * *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String * *.env*)",
      "Edit(scripts/legacy/**)"
    ],
    "ask": [
      "mcp__plugin_dossard-equipe_dossard__query_view"
    ]
  },
  "extraKnownMarketplaces": {
    "equipe-dossard": {
      "source": { "source": "directory", "path": "." }
    }
  },
  "enabledPlugins": {
    "dossard-equipe@equipe-dossard": true
  }
}
