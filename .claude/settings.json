{
  "permissions": {
    "allow": ["mcp__dossard__list_views"],
    "ask": ["mcp__dossard__query_view"],
    "deny": [
      "Read(./.env)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(type *.env*)",
      "Bash(grep * *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String * *.env*)",
      "Edit(scripts/legacy/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/garde.py"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__dossard__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/journal_mcp.py"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/formate.py"]
          }
        ]
      }
    ]
  }
}
